{% extends 'base.html.twig' %}

{% block title %}{{ movie.title }}{% endblock %}

{% block body %}
    <h1>{{ movie.title }}</h1>
    <p>Год выпуска: {{ movie.year }}</p>
    <p>{{ movie.description }}</p>
    <form action="{{ path('movie_index') }}" method="get">
        <button type="submit">Назад к списку фильмов</button>
    </form>
{% endblock %}
