{% extends 'base.html.twig' %}

{% block title %}Список фильмов{% endblock %}

{% block body %}
    <h1>Список фильмов</h1>

    <table border="1">
        <thead>
            <tr>
                <th>Название</th>
                <th>Год</th>
                <th>Действие</th>
            </tr>
        </thead>
        <tbody>
            {% for movie in movies %}
                <tr>
                    <td>{{ movie.title }}</td>
                    <td>{{ movie.year }}</td>
                    <td>
                        <form action="{{ path('movie_show', {id: movie.id}) }}" method="get">
                            <button type="submit">Подробнее</button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
